generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")   // needed for Neon / Supabase pooling
}

// --- NextAuth models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("admin")
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Wedding models ---

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("text")
  updatedAt DateTime @updatedAt
}

model Invitee {
  id             String    @id @default(cuid())
  name           String
  email          String?
  phone          String?
  plusOne        Boolean   @default(false)
  plusOneName    String?
  tableNumber    String?
  group          String?
  notes          String?
  qrCode         String    @unique
  rsvpToken      String?   @unique  // unique token for email-link RSVP
  inviteSentAt        DateTime?
  reminderSentAt      DateTime?
  confirmationSentAt  DateTime?           // when the RSVP confirmation email was sent
  source         String    @default("imported") // imported | self_registered
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  rsvp           RSVP?
}

model RSVP {
  id         String   @id @default(cuid())
  inviteeId  String   @unique
  invitee    Invitee  @relation(fields: [inviteeId], references: [id], onDelete: Cascade)
  attending  Boolean
  plusOne    Boolean  @default(false)
  dietaryReq String?
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Venue {
  id          String   @id @default(cuid())
  name        String
  type        String
  address     String
  city        String?
  mapLink     String?
  coordinates String?
  description String?
  eventDate   String?
  eventTime   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgendaItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  time        String
  eventDate   String
  sortOrder   Int      @default(0)
  icon        String?
  venueId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gift {
  id           String         @id @default(cuid())
  name         String
  description  String?
  price        Float?
  imageUrl     String?
  donationLink String?
  category     String?
  // Payment method: physical | momo | momo_mtn | momo_vodafone | momo_airtel | bank | token
  giftType          String         @default("physical")
  // Multi-network MoMo support (set any that apply)
  momoMtnNumber     String?        // MTN MoMo number
  momoTelecelNumber String?        // Telecel Cash number
  momoAirtelNumber  String?        // AirtelTigo number
  momoNumber        String?        // Legacy / generic fallback number
  momoName          String?        // Account name on MoMo (shared)
  bankName     String?        // e.g. GCB, Ecobank, Fidelity, Stanbic
  bankAccount  String?
  bankBranch   String?
  priority     Int            @default(0)
  claimed      Boolean        @default(false)
  claimedBy    String?
  coupons      GiftCoupon[]
  momoPayments MomoPayment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// Records every MoMo payment attempt (Paystack charge or manual confirm)
model MomoPayment {
  id          String    @id @default(cuid())
  giftId      String?
  gift        Gift?     @relation(fields: [giftId], references: [id], onDelete: SetNull)
  donorName   String?
  donorPhone  String
  network     String    // mtn | telecel | airtel
  amount      Float     // GHS
  reference   String    @unique
  status      String    @default("pending") // pending | success | failed
  paystackRef String?
  displayText String?   // message returned by Paystack to show the user
  note        String?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Gift coupons / digital tokens — unique codes sent to guests
model GiftCoupon {
  id        String    @id @default(cuid())
  gift      Gift      @relation(fields: [giftId], references: [id], onDelete: Cascade)
  giftId    String
  code      String    @unique  // e.g. GIFT-EKE-X7K2
  value     Float?             // GHS value
  note      String?
  sentTo    String?            // email sent to
  sentAt    DateTime?
  claimedBy String?            // name of claimer
  claimedAt DateTime?
  createdAt DateTime  @default(now())
}

model MediaItem {
  id        String   @id @default(cuid())
  type      String
  url       String
  caption   String?
  category  String?
  featured  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model EmailLog {
  id         String   @id @default(cuid())
  subject    String
  body       String
  recipients String
  status     String   @default("sent")
  sentAt     DateTime @default(now())
}
